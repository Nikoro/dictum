--swiftversion 6.0
--indent 4
--linebreaks lf
--wraparguments before-first
--wrapcollections before-first
--closingparen balanced
--commas inline
--trimwhitespace always
--insertlines enabled
--removelines enabled
--header ignore
--stripunusedargs closure-only
--self remove
--ifdef no-indent
--xcodeindentation enabled
--exclude build,Dictum.xcodeproj,website,.agents,.claude,.tools,.git,.github,.vscode
--maxwidth 130

# Explicit rule list, so a SwiftFormat upgrade cannot change results by enabling new defaults.
# docComments is left out on purpose: it would turn `// Edge case:` notes into `///`.
--disable all
--enable andOperator
--enable anyObjectProtocol
--enable applicationMain
--enable assertionFailures
--enable blankLineAfterImports
--enable blankLinesAroundMark
--enable blankLinesAtEndOfScope
--enable blankLinesAtStartOfScope
--enable blankLinesBetweenChainedFunctions
--enable blankLinesBetweenImports
--enable blankLinesBetweenScopes
--enable braces
--enable conditionalAssignment
--enable consecutiveBlankLines
--enable consecutiveSpaces
--enable consistentSwitchCaseSpacing
--enable contentBuilder
--enable docCommentsBeforeModifiers
--enable duplicateImports
--enable elseOnSameLine
--enable emptyBraces
--enable enumNamespaces
--enable environmentEntry
--enable extensionAccessControl
--enable extensionAttributes
--enable fileHeader
--enable fileMacro
--enable genericExtensions
--enable headerFileName
--enable hoistAwait
--enable hoistPatternLet
--enable hoistTry
--enable indent
--enable initCoderUnavailable
--enable leadingDelimiters
--enable linebreakAtEndOfFile
--enable linebreaks
--enable modifierOrder
--enable modifiersOnSameLine
--enable nestedIf
--enable noForceTryInTests
--enable noForceUnwrapInTests
--enable numberFormatting
--enable opaqueGenericParameters
--enable preferForLoop
--enable preferKeyPath
--enable redundantAsync
--enable redundantBackticks
--enable redundantBreak
--enable redundantClosure
--enable redundantEmptyView
--enable redundantEnumerated
--enable redundantEquatable
--enable redundantExtensionACL
--enable redundantFileprivate
--enable redundantGet
--enable redundantInit
--enable redundantInternal
--enable redundantLet
--enable redundantLetError
--enable redundantMemberwiseInit
--enable redundantNilInit
--enable redundantObjc
--enable redundantOptionalBinding
--enable redundantParens
--enable redundantPattern
--enable redundantPublic
--enable redundantRawValues
--enable redundantReturn
--enable redundantSelf
--enable redundantStaticSelf
--enable redundantSwiftTestingSuite
--enable redundantSwiftUIGroup
--enable redundantThrows
--enable redundantType
--enable redundantTypedThrows
--enable redundantVariable
--enable redundantVoidReturnType
--enable repeatedGuard
--enable semicolons
--enable simplifyGenericConstraints
--enable sortDeclarations
--enable sortImports
--enable sortTypealiases
--enable spaceAroundBraces
--enable spaceAroundBrackets
--enable spaceAroundComments
--enable spaceAroundGenerics
--enable spaceAroundOperators
--enable spaceAroundParens
--enable spaceInsideBraces
--enable spaceInsideBrackets
--enable spaceInsideComments
--enable spaceInsideGenerics
--enable spaceInsideParens
--enable strongOutlets
--enable strongifiedSelf
--enable swiftTestingTestCaseNames
--enable todos
--enable trailingClosures
--enable trailingCommas
--enable trailingSpace
--enable typeSugar
--enable unusedArguments
--enable void
--enable wrap
--enable wrapArguments
--enable wrapAttributes
--enable wrapFunctionBodies
--enable wrapIfExpressionBodies
--enable wrapIfStatementBodies
--enable wrapLoopBodies
--enable wrapMultilineStatementBraces
--enable wrapPropertyBodies
--enable wrapSingleLineComments
--enable yodaConditions
