  "strings": {
    "NSDocumentsFolderUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dictum moves the speech models it downloaded earlier out of your Documents folder."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dictum przenosi pobrane wcześniej modele mowy z folderu Dokumenty."
          }
        }
      }
    },
    "NSMicrophoneUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dictum needs microphone access to transcribe speech to text."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dictum potrzebuje mikrofonu do transkrypcji mowy na tekst."
          }
        }
      }
    }
  },
  "version": "1.0"
}
