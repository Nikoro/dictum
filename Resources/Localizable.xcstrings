        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usunie modele LLM, ustawienia i przeniesie Dictum do Kosza. Modele Whisper w ~/.cache/huggingface/ trzeba usunąć ręcznie. Tej operacji nie można cofnąć."
          }
        }
      }
    },
