    },
    "stt.benchmark.scope": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Measured on 50 Polish FLEURS recordings, 5.4–18.2 seconds each, on M4. Lower word error rate is better. Timings measure full-clip inference in the tested local build, after model loading and without text cleanup; they are not end-to-end dictation delay. This small sample may not reflect your voice or other languages."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pomiar na M4 dla 50 polskich nagrań FLEURS, po 5,4–18,2 s. Niższy odsetek błędów słów jest lepszy. Czasy dotyczą obliczeń dla całego nagrania w testowanej lokalnej wersji, po załadowaniu modelu i bez poprawiania tekstu; nie są całkowitym opóźnieniem dyktowania. Ta mała próbka nie musi odzwierciedlać Twojego głosu ani innych języków."
          }
        }
      }
    }
  },
  "version": "1.0"
